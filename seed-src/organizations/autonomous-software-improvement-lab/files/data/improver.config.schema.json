{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "improver-config-1.schema.json",
  "title": "Autonomous Software Improvement Lab kit configuration (improver-config/1)",
  "description": "Relative paths resolve from the directory of the config file; a leading ~ means the home directory. The kit writes only inside state_dir and adds local worktrees and branches to the project repository.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "project",
    "state_dir",
    "strategists",
    "seed",
    "verify",
    "protected_paths"
  ],
  "properties": {
    "schema": {
      "const": "improver-config/1"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "path",
        "context",
        "surfaces",
        "base_branch",
        "integration_branch"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "The top of the project's git work tree."
        },
        "context": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000,
          "description": "What the software is, who uses it and what matters; quoted in every brief."
        },
        "surfaces": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": [
              "api",
              "cli",
              "data",
              "library",
              "service",
              "ui"
            ]
          },
          "description": "Which kinds of surface the software has; lenses that need other surfaces are skipped."
        },
        "base_branch": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$",
          "maxLength": 200,
          "description": "The owner's branch; the loop never changes it."
        },
        "integration_branch": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$",
          "maxLength": 200,
          "description": "Created from base_branch by init; only verified generations are fast-forwarded onto it."
        },
        "branch_prefix": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$",
          "maxLength": 200,
          "default": "improve",
          "description": "Strategist branches are <prefix>/g<gen>-<slug>."
        }
      }
    },
    "state_dir": {
      "type": "string",
      "minLength": 1,
      "description": "Plans, briefs, reports, tallies, receipts, the review and the worktrees. Must be outside the project."
    },
    "strategists": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16,
      "default": 8
    },
    "seed": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "description": "Makes strategy choice reproducible."
    },
    "focus": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "maxLength": 4000,
          "description": "The owner's focus for the next generation, quoted in every brief; empty for none."
        },
        "prefer_tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "description": "Plan lenses with these tags first."
        }
      }
    },
    "verify": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "run"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "run": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            },
            "description": "An argument list run without a shell, e.g. [\"npm\", \"test\"]."
          },
          "cwd": {
            "type": "string",
            "default": ".",
            "description": "Relative to the checkout; may not leave it."
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 86400,
            "default": 1800
          },
          "hermetic_home": {
            "type": "boolean",
            "default": true,
            "description": "Run with a throwaway HOME, USERPROFILE, XDG and temp directories."
          },
          "env": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            }
          }
        }
      }
    },
    "harness": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "run",
            "description"
          ],
          "properties": {
            "run": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "description": "An argument list run without a shell, e.g. [\"npm\", \"test\"]."
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8000
            }
          }
        }
      ],
      "description": "The only allowed way to run the software's interface or live services, if it has any."
    },
    "protected_paths": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "The owner's live data, profiles and configuration. Audited after every generation; must not overlap the project or state_dir."
    },
    "live_ports": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 65535
      },
      "description": "Ports of the owner's live software that no agent may touch."
    },
    "clear_env_prefixes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "description": "Environment variables with these prefixes are removed before verify commands run."
    },
    "stale_minutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1440,
      "default": 30,
      "description": "An agent with no report and no writes for this long is treated as dead."
    },
    "nice": {
      "type": "integer",
      "minimum": 0,
      "maximum": 19,
      "default": 10,
      "description": "CPU niceness for verify commands on POSIX, so the owner's software stays responsive."
    },
    "strategy_pool": {
      "type": "string",
      "description": "Defaults to data/strategy-pool.json in the seed."
    },
    "templates_dir": {
      "type": "string",
      "description": "Defaults to templates/ in the seed."
    }
  }
}
